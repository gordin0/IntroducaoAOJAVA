modules = ["java-graalvm22.3"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Executar main.java"

[[workflows.workflow]]
name = "Executar main.java"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "javac main.java && java main"

[workflows.workflow.metadata]
outputType = "console"
